{
  // Cloudflare config, used by the GitHub deploy and `npm run deploy` (npx wrangler deploy).
  "name": "vertexform",
  "compatibility_date": "2026-09-01",
  // The Worker only handles /api/* (the opt-in AI coach summary, worker/index.js);
  // every other request is a static file from public/, served as before.
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
  // The API key is a Secret set in the dashboard (Settings → Variables and Secrets →
  // ANTHROPIC_API_KEY), never in this file.
}
